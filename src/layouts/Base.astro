---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import { CONSENT_KEY, RESPECT_CONSENT_REJECT } from '../lib/ads';

interface Props {
  title: string;
  description?: string;
  /** Path-relative or absolute image URL for Open Graph + Twitter. */
  ogImage?: string;
  /** Canonical path (defaults to current pathname). Useful to dedupe with/without trailing slash. */
  canonicalPath?: string;
  /** Page type for OpenGraph (default 'website'). */
  ogType?: 'website' | 'article';
  /** Optional JSON-LD structured-data object(s) to inject into <head>. */
  jsonLd?: object | object[];
  /** ISO date string for article:published_time (blog posts). */
  publishedTime?: string;
  /** Author name for article:author (blog posts). */
  articleAuthor?: string;
  /** Set true to add noindex (e.g. user-specific pages). */
  noindex?: boolean;
  /** OG article tags for blog posts. */
  articleTags?: string[];
  /** Show the leaderboard ad above the footer (off for legal and error pages). */
  ads?: boolean;
}

const SITE_URL = 'https://worldradiostations.org';
const SITE_NAME = 'World Radio Stations';
const DEFAULT_DESC = 'Listen to thousands of radio stations from around the world online — pop, rock, jazz, news and more. Filter by country, straight in your browser, no sign-up.';

const {
  title,
  description = DEFAULT_DESC,
  ogImage = '/og.png',
  canonicalPath,
  ogType = 'website',
  jsonLd,
  publishedTime,
  articleAuthor,
  noindex = false,
  articleTags = [],
  ads = true,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href);

const canonical = new URL(canonicalPath ?? path, SITE_URL).toString();
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  sameAs: [],
};
const jsonLdArr = [orgJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b16" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title="World Radio Stations — Blog" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {jsonLdArr.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    {/*
      AdSense — uncomment after approval and replace ca-pub-XXXXXXXXXXXXXXXX
      with your real publisher ID. The slots in the page templates will start
      filling automatically.

      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    */}

    <!-- Google tag (gtag.js) with Consent Mode v2.
         Storage consent defaults to denied; the cookie banner upgrades it.
         Must run before the gtag.js loader. -->
    {RESPECT_CONSENT_REJECT && (
      <script is:inline define:vars={{ CONSENT_KEY }}>
        try {
          if (localStorage.getItem(CONSENT_KEY) === 'reject') document.documentElement.dataset.ads = 'off';
        } catch (e) {}
      </script>
    )}

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem('wrs-consent-v1') === 'accept') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) {}
      gtag('js', new Date());
      gtag('config', 'G-YTN8XCRQPB');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YTN8XCRQPB"></script>

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header class="site">
      <div class="container row">
        <a class="brand" href="/" aria-label="World Radio Stations — home">
          <img src="/logo-mark.svg" alt="" width="40" height="40" />
          <span class="brand-text">
            <span class="brand-name">World Radio</span>
            <span class="brand-sub">Stations</span>
          </span>
        </a>
        <nav class="site" id="main-nav" aria-label="Main">
          <a href="/" class:list={{ active: isActive('/') }}>Listen</a>
          <a href="/moods" class:list={{ active: path.startsWith('/moods') }}>Discover</a>
          <a href="/country" class:list={{ active: path.startsWith('/country') }}>Countries</a>
          <a href="/stations" class:list={{ active: path.startsWith('/stations') }}>Stations</a>
          <a href="/blog" class:list={{ active: path.startsWith('/blog') }}>Blog</a>
          <a href="/about" class:list={{ active: isActive('/about') }}>About</a>
          <a href="/contact" class:list={{ active: isActive('/contact'), 'nav-mobile-only': true }}>Contact</a>
        </nav>
        <div class="header-actions">
          <a class:list={['icon-link', { active: isActive('/favorites') }]} href="/favorites" aria-label="Favorites" title="Favorites">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 17.3l-5.4 3.2 1.4-6.1L3 10.4l6.2-.5L12 4l2.8 5.9 6.2.5-5 4 1.4 6.1z"/></svg>
          </a>
          <a class:list={['icon-link', { active: isActive('/history') }]} href="/history" aria-label="History" title="History">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>
          </a>
          <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {ads && (
      <div class="container">
        <AdSlot type="leaderboard" class="ad-footer" />
      </div>
    )}

    <footer class="site">
      <div class="container footer-grid">
        <div class="footer-col footer-brand">
          <a class="footer-logo" href="/" aria-label="World Radio Stations — home">
            <img src="/logo.svg" alt="World Radio Stations" width="223" height="60" loading="lazy" />
          </a>
          <p>Spin the globe and tune in to live radio from every corner of the world — free, right in your browser. An Android app is coming soon.</p>
        </div>
        <div class="footer-col">
          <h4>App</h4>
          <a href="/">Listen online</a>
          <a href="/moods">Discover by mood</a>
          <a href="/favorites">Favorites</a>
          <a href="/history">History</a>
        </div>
        <div class="footer-col">
          <h4>Information</h4>
          <a href="/country">Countries</a>
          <a href="/stations">Stations</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/copyright">Content &amp; copyright</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 World Radio Stations. All rights reserved.</span>
        <span class="footer-credit">Stations provided by <a href="https://www.radio-browser.info" target="_blank" rel="noopener noreferrer">Radio Browser</a>.</span>
      </div>
    </footer>

    <!-- Cookie consent banner -->
    <div class="consent" data-consent hidden>
      <div class="consent-inner container">
        <div class="consent-text">
          <strong>This site uses cookies</strong>
          <p>
            Necessary storage remembers your choices (player, favorites, view).
            With your consent we also use Google Analytics to understand how the
            site is used, and our advertising partner Adsterra shows ads that keep
            the site free. Details in our <a href="/privacy-policy">Privacy Policy</a>.
          </p>
        </div>
        <div class="consent-actions">
          <button type="button" class="cta-secondary" data-consent-reject>Necessary only</button>
          <button type="button" class="cta" data-consent-accept>Accept</button>
        </div>
      </div>
    </div>

    <script>
      import { CONSENT_KEY, RESPECT_CONSENT_REJECT as RESPECT_REJECT } from '../lib/ads';

      // Cookie consent: hide if a choice was already made; persist on click.
      (() => {
        const KEY = CONSENT_KEY;
        const banner = document.querySelector('[data-consent]') as HTMLElement | null;
        if (!banner) return;
        if (localStorage.getItem(KEY)) return;
        banner.hidden = false;
        const close = (value: 'accept' | 'reject') => {
          try { localStorage.setItem(KEY, value); } catch {}
          if (value === 'reject' && RESPECT_REJECT) {
            document.documentElement.dataset.ads = 'off';
          }
          if (value === 'accept') {
            (window as any).gtag?.('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted',
            });
          }
          banner.hidden = true;
        };
        banner.querySelector('[data-consent-accept]')?.addEventListener('click', () => close('accept'));
        banner.querySelector('[data-consent-reject]')?.addEventListener('click', () => close('reject'));
      })();

      // Mobile nav toggle
      (() => {
        const btn = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
        const nav = document.querySelector('#main-nav') as HTMLElement | null;
        if (!btn || !nav) return;
        btn.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            nav.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      })();

      // Register service worker for PWA
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
