---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RadioPlayer from '../../components/RadioPlayer.astro';
import { getCollection } from 'astro:content';
import { countryName, inCountry } from '../../scripts/countries';

export const prerender = false;

const { uuid } = Astro.params;
const API = 'https://de1.api.radio-browser.info/json';
const FETCH_HEADERS = { 'User-Agent': 'WorldRadioStations/1.0 (+https://worldradiostations.org)' };
const isPlayable = (s: any) => typeof s?.url_resolved === 'string' && s.url_resolved.startsWith('https://');

let station: any = null;
if (uuid && /^[a-fA-F0-9-]{8,64}$/.test(uuid)) {
  try {
    const res = await fetch(`${API}/stations/byuuid/${encodeURIComponent(uuid)}`, { headers: FETCH_HEADERS });
    if (res.ok) {
      const list = await res.json();
      const s = Array.isArray(list) ? list[0] : null;
      if (isPlayable(s)) station = s;
    }
  } catch {
    station = null;
  }
}

// A real 404 (not a redirect to /404) so dead stations drop out of the index.
if (!station) Astro.response.status = 404;
Astro.response.headers.set(
  'Cache-Control',
  station ? 'public, max-age=300, s-maxage=3600' : 'public, max-age=60',
);

const str = (v: unknown) => (typeof v === 'string' ? v.trim() : '');
const titleCase = (s: string) => s.replace(/(^|[\s-])\p{Ll}/gu, (m) => m.toUpperCase());
const joinList = (items: string[]) =>
  items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;

const name = str(station?.name) || 'Radio station';
const countryCode = str(station?.countrycode).toUpperCase();
const country = countryCode ? countryName(countryCode) : str(station?.country);
const region = str(station?.state);
const place = [region, country].filter(Boolean).join(', ');
// Mid-sentence form: "from the United Kingdom", "from Bavaria, Germany".
const placeIn = region ? place : inCountry(country);
const genres: string[] = [...new Set<string>(
  str(station?.tags).split(',').map((t: string) => t.trim().toLowerCase()).filter((t: string) => t && t.length <= 30),
)].slice(0, 5);
const languages: string[] = str(station?.language).split(/[,;]/).map((l: string) => titleCase(l.trim())).filter(Boolean).slice(0, 3);
const bitrate = typeof station?.bitrate === 'number' && station.bitrate > 0 ? station.bitrate : 0;
const quality = [str(station?.codec), bitrate ? `${bitrate} kbps` : ''].filter(Boolean).join(' · ');
const homepage = /^https?:\/\//.test(str(station?.homepage)) ? str(station.homepage) : '';
const homepageHost = homepage.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '');
const votes = typeof station?.votes === 'number' ? station.votes : 0;

// Other popular stations from the same country: internal links for crawlers
// and an obvious next step for listeners.
let moreStations: any[] = [];
if (station && countryCode) {
  try {
    const res = await fetch(
      `${API}/stations/bycountrycodeexact/${countryCode}?hidebroken=true&order=clickcount&reverse=true&limit=40`,
      { headers: FETCH_HEADERS },
    );
    if (res.ok) {
      const raw = await res.json();
      const seen = new Set<string>([station.url_resolved]);
      for (const s of Array.isArray(raw) ? raw : []) {
        if (!isPlayable(s) || s.stationuuid === station.stationuuid || seen.has(s.url_resolved)) continue;
        seen.add(s.url_resolved);
        moreStations.push(s);
        if (moreStations.length >= 12) break;
      }
    }
  } catch { /* the section is optional */ }
}

// Link to the editorial profile when we have one for this station.
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '');
const profile = station
  ? (await getCollection('stations')).find(
      (p) => p.data.country === country && norm(p.data.name.replace(/\s*\([^)]*\)/g, '')) === norm(name),
    )
  : undefined;

const faqs = station
  ? [
      {
        q: `How can I listen to ${name} live?`,
        a: `Press play on the player at the top of this page and ${name} streams live in your browser — free, with no app or account. Tap the star to save it to your favorites so it’s one click away next time.`,
      },
      ...(place
        ? [{ q: `Where is ${name} from?`, a: `${name} broadcasts from ${placeIn}${languages.length ? ` in ${joinList(languages)}` : ''}.` }]
        : []),
      ...(genres.length
        ? [{ q: `What does ${name} play?`, a: `${name} is listed under ${joinList(genres.slice(0, 4))}.${quality ? ` Its online stream is ${quality}.` : ''}` }]
        : []),
      {
        q: `Can I listen to ${name} outside ${country || 'its home country'}?`,
        a: `Yes — the stream works anywhere with an internet connection. If it doesn’t start, the station may be offline for a moment or restricting some programmes by region; try again later or pick another ${country ? `${country} ` : ''}station below.`,
      },
    ]
  : [];

const title = station
  ? `${name} Live — Listen Online Free${country ? ` | ${country} Radio` : ''}`
  : 'Station not found — World Radio Stations';
const description = station
  ? `Listen to ${name} live online for free${genres.length ? ` — ${genres.slice(0, 3).join(', ')} radio` : ''}${place ? ` from ${placeIn}` : ''}. Streams in your browser, no app or sign-up needed.`
  : 'This radio station is no longer available. Browse thousands of other live stations from around the world.';
const ogImage = typeof station?.favicon === 'string' && station.favicon.startsWith('https://') ? station.favicon : '/og.png';

const jsonLd = station
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }, {
      '@context': 'https://schema.org',
      '@type': 'RadioStation',
      name,
      description,
      ...(homepage ? { url: homepage } : {}),
      ...(ogImage !== '/og.png' ? { logo: ogImage } : {}),
      ...(country ? { areaServed: { '@type': 'Country', name: country } } : {}),
      ...(languages.length ? { inLanguage: languages.join(', ') } : {}),
      ...(genres.length ? { keywords: genres.join(', ') } : {}),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://worldradiostations.org/listen/${station.stationuuid}`,
      },
    }]
  : undefined;
---
<Base
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  noindex={!station}
  ads={Boolean(station)}
>
  {station ? (
    <>
      <Breadcrumbs crumbs={[
        { label: 'Home', href: '/' },
        ...(countryCode
          ? [
              { label: 'Countries', href: '/country' },
              { label: country, href: `/country/${countryCode.toLowerCase()}` },
            ]
          : []),
        { label: name },
      ]} />

      <section class="container listen-head">
        <p class="listen-eyebrow">Now playing</p>
        <h1>{name}</h1>
        <p class="page-sub">{[place, genres.slice(0, 4).join(', ')].filter(Boolean).join(' · ') || 'Live radio stream'}</p>
        {homepage && (
          <p class="listen-links">
            <a href={homepage} target="_blank" rel="noopener noreferrer">Official site ↗</a>
          </p>
        )}
      </section>

      <section class="container player-section">
        <RadioPlayer autoplay={station.stationuuid} countryDefault={countryCode} />
      </section>

      <div class="container">
        <AdSlot type="leaderboard" />
      </div>

      <section class="container listen-about" aria-labelledby="about-heading">
        <div class="section-head">
          <h2 id="about-heading">About {name}</h2>
        </div>
        <div class="prose">
          <p>
            {name} is a radio station{place && ` from ${placeIn}`}{languages.length > 0 && ` broadcasting in ${joinList(languages)}`}{genres.length > 0 && `, with ${joinList(genres.slice(0, 3))} programming`}.
          </p>
          <p>
            Listen to {name} live online for free with the player above. The stream{quality && ` (${quality})`} plays
            directly from the station’s own server, so there’s no app to install and no sign-up.
          </p>
          {profile && (
            <p><a class="link-arrow" href={`/stations/${profile.slug}`}>{profile.data.name} frequencies, history &amp; how to listen →</a></p>
          )}
        </div>
        <div class="station-infobox">
          <table><tbody>
            {country && countryCode && <tr><th>Country</th><td><a href={`/country/${countryCode.toLowerCase()}`}>{country}</a></td></tr>}
            {country && !countryCode && <tr><th>Country</th><td>{country}</td></tr>}
            {region && <tr><th>Region</th><td>{region}</td></tr>}
            {languages.length > 0 && <tr><th>Language</th><td>{languages.join(', ')}</td></tr>}
            {genres.length > 0 && <tr><th>Genres</th><td>{genres.join(', ')}</td></tr>}
            {quality && <tr><th>Stream</th><td>{quality}</td></tr>}
            {homepage && (
              <tr><th>Website</th><td><a href={homepage} target="_blank" rel="noopener noreferrer">{homepageHost}</a></td></tr>
            )}
            {votes > 0 && <tr><th>Listener votes</th><td>{votes.toLocaleString('en')}</td></tr>}
          </tbody></table>
        </div>
      </section>

      {moreStations.length > 0 && (
        <section class="container" aria-labelledby="more-heading">
          <div class="section-head">
            <h2 id="more-heading">More radio stations from {inCountry(country)}</h2>
          </div>
          <div class="facet-grid">
            {moreStations.map((s) => (
              <a class="facet-card" href={`/listen/${s.stationuuid}`}>
                <span class="facet-name">{str(s.name)}</span>
                <span class="facet-count">{str(s.tags).split(',').map((t: string) => t.trim()).filter(Boolean).slice(0, 3).join(', ') || 'Listen live'}</span>
              </a>
            ))}
          </div>
          <p style="margin-top:1.5rem;"><a class="link-arrow" href={`/country/${countryCode.toLowerCase()}`}>All {country} radio stations →</a></p>
        </section>
      )}

      <div class="container">
        <AdSlot type="native" />
      </div>

      <section class="container page-faq" aria-labelledby="listen-faq-heading">
        <div class="section-head">
          <h2 id="listen-faq-heading">{name}: frequently asked questions</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </>
  ) : (
    <section class="container not-found">
      <div class="not-found-inner">
        <div class="not-found-code">404</div>
        <h1>This station is off the air</h1>
        <p>
          We couldn’t find this radio station — it may have stopped streaming or been removed from the
          directory. There are thousands of others to choose from.
        </p>
        <div class="hero-ctas">
          <a class="cta" href="/">Browse live stations</a>
          <a class="cta cta-secondary" href="/country">Stations by country</a>
        </div>
      </div>
    </section>
  )}
</Base>
