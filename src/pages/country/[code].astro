---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RadioPlayer from '../../components/RadioPlayer.astro';
import { getCollection } from 'astro:content';
import { ALL_COUNTRY_CODES, COUNTRIES, countryName, inCountry } from '../../scripts/countries';

export const prerender = false;

const SITE_URL = 'https://worldradiostations.org';
const API = 'https://de1.api.radio-browser.info/json';
const FETCH_HEADERS = { 'User-Agent': 'WorldRadioStations/1.0 (+https://worldradiostations.org)' };

const { code = '' } = Astro.params;
const cc = code.replace(/[^a-zA-Z]/g, '').slice(0, 2).toUpperCase();
const def = COUNTRIES.find((c) => c.code === cc);

// Top stations for the crawlable list (the embedded player loads its own).
let stations: any[] = [];
let totalCount = 0;
let apiOk = false;
try {
  const res = await fetch(
    `${API}/stations/bycountrycodeexact/${cc}?hidebroken=true&order=clickcount&reverse=true&limit=60`,
    { headers: FETCH_HEADERS },
  );
  if (res.ok) {
    apiOk = true;
    const raw = await res.json();
    const seen = new Set<string>();
    for (const s of Array.isArray(raw) ? raw : []) {
      const u = s?.url_resolved;
      if (typeof u !== 'string' || !u.startsWith('https://') || seen.has(u)) continue;
      seen.add(u);
      stations.push(s);
    }
  }
} catch { /* graceful */ }
try {
  const res = await fetch(`${API}/countries?hidebroken=true`, { headers: FETCH_HEADERS });
  if (res.ok) {
    const list = await res.json();
    const m = Array.isArray(list)
      ? list.find((c: any) => (c?.iso_3166_1 || '').toUpperCase() === cc)
      : null;
    totalCount = m?.stationcount || 0;
  }
} catch { /* graceful */ }

const isKnown = ALL_COUNTRY_CODES.includes(cc);
const name = def?.name || (isKnown ? countryName(cc) : stations[0]?.country || cc);
const the = inCountry(name);

if (!isKnown || (apiOk && stations.length === 0)) {
  Astro.response.status = 404;
} else if (!apiOk) {
  // Radio Browser is down and there's nothing to list: ask crawlers to retry
  // instead of indexing (or dropping) an empty page.
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '600');
}
const isOk = Astro.response.status === 200;

Astro.response.headers.set(
  'Cache-Control',
  isOk ? 'public, max-age=300, s-maxage=1800' : 'public, max-age=30',
);

const shown = stations.slice(0, 48);
const popularNames = [...new Set<string>(shown.map((s) => String(s.name || '').trim()).filter(Boolean))].slice(0, 5);
const related = COUNTRIES.filter((c) => c.code !== cc).slice(0, 12);

// Directory entries that match an editorial station profile link internally.
// Name-normalized and country-scoped so foreign namesakes can't collide.
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '');
const profileSlugByName = new Map<string, string>();
const guides = (await getCollection('stations'))
  .filter((p) => p.data.country === name)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));
for (const p of guides) profileSlugByName.set(norm(p.data.name), p.slug);

// Blog posts about this country (tagged with it, or linking to this page).
const countryPath = `/country/${cc.toLowerCase()}`;
const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes(name.toLowerCase()) || (p.body || '').includes(`${countryPath})`))
  .slice(0, 3);

const top5 = popularNames.slice(0, 5);
const top5List = top5.length < 2 ? top5.join('') : `${top5.slice(0, -1).join(', ')} and ${top5[top5.length - 1]}`;
const faqs = isOk && top5.length >= 3
  ? [
      {
        q: `What are the most popular radio stations in ${the}?`,
        a: `The most-listened ${name} stations on World Radio Stations right now are ${top5List}. The list above is ranked by listener clicks in the Radio Browser directory and updates through the day.`,
      },
      {
        q: `How many ${name} radio stations can I listen to online?`,
        a: `${totalCount > 0 ? `Radio Browser lists ${totalCount.toLocaleString('en')} stations from ${the}. ` : ''}This page shows the ${shown.length} most popular ones that stream over a secure connection, so they play straight in your browser. Use the search box in the player to find any other station by name or genre.`,
      },
      {
        q: `Can I listen to ${name} radio from abroad?`,
        a: `Yes. Almost every station on this page streams worldwide, so you can listen from anywhere with an internet connection. A few broadcasters block some programmes outside ${the} for rights reasons (live sport is the usual one).`,
      },
      {
        q: `Is it free to listen to ${name} radio stations here?`,
        a: 'Yes. Listening is free, with no account and no app to install — press play on any station and the stream starts in your browser.',
      },
    ]
  : [];

const stationTags = (s: any): string =>
  (typeof s.tags === 'string' ? s.tags : '')
    .split(',')
    .map((t: string) => t.trim())
    .filter(Boolean)
    .slice(0, 3)
    .join(', ');

const jsonLd = [
  ...(faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${name} radio stations`,
    description: `Listen to radio stations from ${the} live online, free in your browser.`,
    inLanguage: 'en',
    url: `${SITE_URL}/country/${cc.toLowerCase()}`,
  },
  ...(shown.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        numberOfItems: shown.length,
        itemListElement: shown.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: s.name,
          url: `${SITE_URL}/listen/${s.stationuuid}`,
        })),
      }]
    : []),
];
---
<Base
  title={`${name} Radio Stations — Listen Live Online Free`}
  description={`Listen to ${totalCount ? `${totalCount.toLocaleString('en')} ` : ''}radio stations from ${the} live online${popularNames.length ? ` — ${popularNames.slice(0, 3).join(', ')} and more` : ' — news, music and talk'}, free in your browser. No sign-up.`}
  jsonLd={jsonLd}
  noindex={!isOk || shown.length < 3}
  ads={isOk}
>
  <Breadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Countries', href: '/country' },
    { label: name },
  ]} />

  <section class="container page-head">
    <h1>{name} radio stations — listen live online</h1>
    <p class="page-sub">
      Listen to live radio from {the} for free, straight in your browser — news, talk, music and sport.
      {totalCount > 0 && ` ${totalCount.toLocaleString('en')} stations available right now.`}
      Press play on any station: streams come directly from each broadcaster’s own servers, with no app or sign-up.
    </p>
  </section>

  <section class="container player-section">
    <RadioPlayer countryDefault={cc} />
  </section>

  {isOk && (
    <div class="container">
      <AdSlot type="leaderboard" />
    </div>
  )}

  {shown.length > 0 && (
    <section class="container">
      <div class="section-head">
        <h2>Top {name} radio stations</h2>
        <p>
          The most-listened stations from {the} on World Radio Stations{popularNames.length >= 3 && `, including ${popularNames.slice(0, -1).join(', ')} and ${popularNames[popularNames.length - 1]}`}.
        </p>
      </div>
      <div class="facet-grid">
        {shown.map((s) => {
          const profileSlug = profileSlugByName.get(norm(s.name || ''));
          const tags = stationTags(s);
          return (
            <a
              class="facet-card"
              href={profileSlug ? `/stations/${profileSlug}` : `/listen/${s.stationuuid}`}
            >
              <span class="facet-name">{s.name}</span>
              <span class="facet-count">{profileSlug ? 'Profile & how to listen' : (tags || 'Listen live')}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {isOk && (
    <div class="container">
      <AdSlot type="native" />
    </div>
  )}

  {(guides.length > 0 || posts.length > 0) && (
    <section class="container country-guides">
      <div class="section-head">
        <h2>{name} station guides</h2>
        <p>Frequencies, history and how to listen to {name}’s best-known stations.</p>
      </div>
      {guides.length > 0 && (
        <div class="facet-grid">
          {guides.map((g) => (
            <a class="facet-card" href={`/stations/${g.slug}`}>
              <span class="facet-name">{g.data.name}</span>
              <span class="facet-count">{g.data.frequencies[0] ?? g.data.format}</span>
            </a>
          ))}
        </div>
      )}
      {posts.length > 0 && (
        <div class="blog-grid" style="margin-top:1rem;">
          {posts.map((p) => (
            <a href={`/blog/${p.slug}`} class="blog-card">
              <div class="blog-card-body">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  )}

  {faqs.length > 0 && (
    <section class="container page-faq" aria-labelledby="country-faq-heading">
      <div class="section-head">
        <h2 id="country-faq-heading">{name} radio: frequently asked questions</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="container">
    <div class="section-head">
      <h2>Other countries</h2>
    </div>
    <div class="facet-grid">
      {related.map((c) => (
        <a class="facet-card" href={`/country/${c.code.toLowerCase()}`}>
          <span class="facet-name">{c.name}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem;"><a class="link-arrow" href="/country">All countries →</a></p>
  </section>
</Base>
