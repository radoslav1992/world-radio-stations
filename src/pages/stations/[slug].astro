---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RadioPlayer from '../../components/RadioPlayer.astro';
import { getCollection } from 'astro:content';
import { ALL_COUNTRY_CODES, countryName, inCountry } from '../../scripts/countries';

export async function getStaticPaths() {
  const stations = await getCollection('stations');
  return stations.map((station) => ({
    params: { slug: station.slug },
    props: { station },
  }));
}

const { station } = Astro.props;
const { Content } = await station.render();

const SITE_URL = 'https://worldradiostations.org';

const d = station.data;
const countryCode = ALL_COUNTRY_CODES.find((code) => countryName(code) === d.country) ?? '';

// Same-country profiles first (that's what people compare against), then
// same-format ones from elsewhere.
const allStations = await getCollection('stations');
const others = allStations.filter((s) => s.slug !== station.slug);
const similar = [
  ...others.filter((s) => s.data.country === d.country),
  ...others.filter((s) => s.data.country !== d.country && s.data.format === d.format),
].slice(0, 6);

const clip = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:—-]+$/, '') + '…';
};

const howToListen = d.frequencies.length ? d.frequencies.join(', ') : 'online streaming';
const hasBroadcast = d.frequencies.some((f) => /\b(FM|AM|MW|LW|DAB|kHz|MHz)\b/.test(f));
const heading = hasBroadcast ? `${d.name} frequency & live stream` : `${d.name}: live stream & station guide`;

// Blog posts that feature or link to this guide.
const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.data.stations.includes(station.slug) || (p.body || '').includes(`/stations/${station.slug})`))
  .sort((a, b) => new Date(b.data.updated ?? b.data.date).getTime() - new Date(a.data.updated ?? a.data.date).getTime())
  .slice(0, 3);
const websiteHost = d.website ? d.website.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';

// Most search traffic to these pages is "<station> frequency" or
// "<station> live", so the title and snippet lead with exactly that.
const title = d.metaTitle ?? `${d.name} — Frequency, Live Stream & How to Listen`;
const description = d.metaDescription
  ?? clip(`How to listen to ${d.name}: ${howToListen}. Listen live online for free, plus the station’s history, owner and programming.`);

// Radio Browser names rarely carry our disambiguating suffixes ("(UK)", call signs).
const playerSearch = d.playerSearch ?? d.name.replace(/\s*\([^)]*\)/g, '').trim();

// One-sentence answer for the "which country / who owns / how to listen"
// queries these pages rank for.
const quickAnswer = [
  `${d.name} is a ${d.format.toLowerCase()} radio station from ${inCountry(d.country)}`,
  d.owner ? `owned by ${d.owner}` : '',
  d.founded ? `on air since ${d.founded}` : '',
].filter(Boolean).join(', ') + '.';

// Station-specific questions first; the generic ones fill the gaps. Every
// question here is rendered on the page as well as in the FAQPage markup.
const frequencyAnswer = d.faq.find((f) => /frequenc/i.test(f.q))?.a;
const faqs: { q: string; a: string }[] = [
  ...d.faq,
  ...(frequencyAnswer
    ? []
    : [{
        q: `What frequency is ${d.name} on?`,
        a: `${d.name} is available on ${howToListen}.`,
      }]),
  {
    q: `Which country is ${d.name} from?`,
    a: `${d.name} is a radio station from ${inCountry(d.country)}${d.headquarters ? `, headquartered in ${d.headquarters}` : ''}. It broadcasts in ${d.language}.`,
  },
  ...(d.owner ? [{ q: `Who owns ${d.name}?`, a: `${d.name} is owned by ${d.owner}.` }] : []),
  {
    q: `How can I listen to ${d.name} online?`,
    a: `You can stream ${d.name} live in your browser with the player on this page${websiteHost ? ` or on the official website, ${websiteHost}` : ''} — free, with no app or sign-up needed.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const pageUrl = `${SITE_URL}/stations/${station.slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RadioStation',
  name: d.name,
  description: d.description,
  ...(d.founded ? { foundingDate: d.founded } : {}),
  ...(d.owner ? { parentOrganization: { '@type': 'Organization', name: d.owner } } : {}),
  areaServed: { '@type': 'Country', name: d.country },
  ...(d.headquarters ? { address: { '@type': 'PostalAddress', addressLocality: d.headquarters, addressCountry: d.country } } : {}),
  ...(d.website ? { url: d.website, sameAs: [d.website] } : {}),
  ...(d.slogan ? { slogan: d.slogan } : {}),
  inLanguage: d.language === 'English' ? 'en' : d.language,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};
---
<Base
  title={title}
  description={description}
  jsonLd={[jsonLd, faqJsonLd]}
>
  <Breadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Stations', href: '/stations' },
    { label: d.name },
  ]} />

  <article>
    <div class="container legal blog-post station-top">
      <h1>{heading}</h1>

      <div class="answer-box">
        <p><strong>{quickAnswer}</strong> How to listen:</p>
        {d.frequencies.length > 0
          ? <ul>{d.frequencies.map((f) => <li>{f}</li>)}</ul>
          : <ul><li>Online stream</li></ul>}
        <div class="answer-actions">
          {countryCode && (
            <a class="cta" href="#listen">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              Listen live now
            </a>
          )}
          <a class="cta cta-secondary" href="#frequencies">Frequency details</a>
        </div>
      </div>

      <div class="station-infobox">
        <table><tbody>
          {d.format && <tr><th>Format</th><td>{d.format}</td></tr>}
          {d.founded && <tr><th>Founded</th><td>{d.founded}</td></tr>}
          {d.owner && <tr><th>Owner</th><td>{d.owner}</td></tr>}
          {d.headquarters && <tr><th>Headquarters</th><td>{d.headquarters}</td></tr>}
          {d.slogan && <tr><th>Slogan</th><td><em>{d.slogan}</em></td></tr>}
          {d.website && (
            <tr><th>Website</th><td><a href={d.website} target="_blank" rel="noopener noreferrer">{websiteHost}</a></td></tr>
          )}
          <tr><th>Language</th><td>{d.language}</td></tr>
          {countryCode && <tr><th>Country</th><td><a href={`/country/${countryCode.toLowerCase()}`}>{d.country}</a></td></tr>}
          {!countryCode && <tr><th>Country</th><td>{d.country}</td></tr>}
        </tbody></table>
      </div>

      <h2 id="frequencies">{d.name} frequency &amp; how to listen</h2>
      {frequencyAnswer
        ? <p>{frequencyAnswer}</p>
        : <p>{d.name} is available on {howToListen}. You can also stream it live with the player below.</p>}

      <AdSlot type="rectangle" />
    </div>

    {countryCode && (
      <section class="container player-section station-player" id="listen" aria-labelledby="listen-heading">
        <div class="section-head">
          <h2 id="listen-heading">Listen to {d.name} live</h2>
          <p>
            Live radio from {inCountry(d.country)}, filtered to {d.name}. Press play to start the stream — or clear
            the search to browse every {d.country} station.
          </p>
        </div>
        <RadioPlayer countryDefault={countryCode} search={playerSearch} globe={false} />
      </section>
    )}

    <div class="container legal blog-post station-body">
      <Content />
      <AdSlot type="native" before=".station-body > h2:nth-of-type(3)" />

      <section class="station-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">{d.name}: frequently asked questions</h2>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      {relatedPosts.length > 0 && (
        <section class="post-related" aria-labelledby="related-posts-heading">
          <h2 id="related-posts-heading">Read more about {d.name}</h2>
          <div class="blog-grid">
            {relatedPosts.map((p) => (
              <a href={`/blog/${p.slug}`} class="blog-card">
                <div class="blog-card-body">
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {similar.length > 0 && (
        <div class="similar-stations">
          <h2>Similar stations</h2>
          <div class="station-directory" style="margin-bottom:2rem;">
            {similar.map((s) => (
              <a href={`/stations/${s.slug}`} class="blog-card">
                <div class="blog-card-body">
                  <div class="blog-card-tags">
                    <span class="tag-chip">{s.data.format}</span>
                    {s.data.country !== d.country && <span class="tag-chip">{s.data.country}</span>}
                  </div>
                  <h3>{s.data.name}</h3>
                  <p>{s.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="blog-cta">
        <p>Explore more radio from {inCountry(d.country)}, or go straight to {d.name}’s official site.</p>
        <div class="hero-ctas">
          {countryCode && (
            <a class="cta cta-secondary" href={`/country/${countryCode.toLowerCase()}`}>{d.country} radio stations</a>
          )}
          {d.website && (
            <a class="cta cta-secondary" href={d.website} target="_blank" rel="noopener noreferrer">Official site</a>
          )}
          <a class="cta cta-secondary" href="/stations">All stations</a>
        </div>
      </div>
    </div>
  </article>
</Base>
