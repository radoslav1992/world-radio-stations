---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Feature from '../components/Feature.astro';
import { COUNTRIES } from '../scripts/countries';
import RadioPlayer from '../components/RadioPlayer.astro';
import { getCollection } from 'astro:content';

// Station guides that already pick up search impressions; a homepage link
// is the strongest internal signal we can give them.
const FEATURED_STATIONS = [
  'talksport', 'bbc-radio-1', 'capital-fm', 'lbc', 'heart-fm', 'absolute-radio',
  'classic-fm-uk', 'npr', 'bbc-radio-5-live', 'bbc-radio-6-music', 'sveriges-radio-p3', 'cadena-cope',
];
const allProfiles = await getCollection('stations');
const featuredStations = FEATURED_STATIONS
  .map((slug) => allProfiles.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const features = [
  {
    title: 'Thousands of stations',
    description: 'Thousands of radio stations from around the world in one place — pop, rock, jazz, news, sports, dance and more.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11h16M4 16h16M9 7l3-3 3 3"/><circle cx="8" cy="16" r="1.5" fill="currentColor"/></svg>',
  },
  {
    title: 'Explore on a 3D globe',
    description: 'Every station is a light on the map. Spin the globe, click a country to tune in, or tap any light to start listening.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg>',
  },
  {
    title: 'Favorite stations',
    description: 'Save the stations you love with one click and find them in their own tab. Quick access to what you listen to most.',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.3l-5.4 3.2 1.4-6.1L3 10.4l6.2-.5L12 4l2.8 5.9 6.2.5-5 4 1.4 6.1z"/></svg>',
  },
  {
    title: 'Listen history',
    description: 'See the stations you played recently and jump back to them with a single tap. Never lose an interesting station.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  },
  {
    title: 'Free and simple',
    description: 'No registration, no subscription, no hidden fees. Open it, pick a station, listen.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7"/></svg>',
  },
  {
    title: 'Plays in the background',
    description: 'Keeps playing while you use other apps or lock your screen. Control it right from the lock screen.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="18" rx="2"/><circle cx="12" cy="17" r="1" fill="currentColor"/></svg>',
  },
];

const faqs = [
  {
    q: 'Is it free?',
    a: 'Yes, completely free — both the web player and the upcoming mobile app. No subscription, no trial period, no hidden fees.',
  },
  {
    q: 'Where do the radio stations come from?',
    a: 'The catalog is powered by Radio Browser — an open, community-maintained database of radio stations from all over the world. The streams themselves are broadcast by the respective stations.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. Just open the site and start listening. Your favorite stations and history are stored locally in your browser.',
  },
  {
    q: 'How do I filter stations by country?',
    a: 'Click any country on the globe, or pick one from the country selector next to it. The globe flies there and the list reloads with that country’s most popular stations. Choose “Worldwide — top stations” to see the most popular stations globally.',
  },
  {
    q: 'How much mobile data does it use?',
    a: 'About 45–90 MB per hour, depending on the stream quality: most stations stream at 96–192 kbps, and a typical 128 kbps stream uses roughly 58 MB an hour. On Wi-Fi, no mobile data is used.',
  },
  {
    q: 'Why do some stations not play?',
    a: 'Browsers block non-HTTPS streams and streams without HLS support. That’s why the web version shows a smaller subset of stations. The upcoming Android app will support all formats.',
  },
  {
    q: 'Does it work everywhere?',
    a: 'Yes, the app works anywhere you have an internet connection. It’s perfect for listening to stations from your home country while travelling or living abroad.',
  },
  {
    q: 'Is it available for iOS / iPhone?',
    a: 'There is no mobile app yet — we’re working on the Android version first. The web version on this site, however, works in any modern browser, including Safari on iOS.',
  },
  {
    q: 'What’s the difference between FM radio and internet radio?',
    a: 'FM radio uses radio frequencies and a receiver, while internet radio delivers audio as a digital stream over the internet. Online streaming means a much wider choice of stations, song metadata and access from anywhere in the world.',
  },
  {
    q: 'How can I add a station that’s missing?',
    a: 'The catalog is powered by Radio Browser — an open, community database. You can submit a new station directly at radio-browser.info, or write to us via the contact page with the stream URL.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'World Radio Stations',
    browserRequirements: 'Requires a modern browser with HTML5 audio support',
    applicationCategory: 'MultimediaApplication',
    description: 'Free web player for thousands of radio stations from around the world, filterable by country. Android app coming soon.',
    inLanguage: 'en',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'World Radio Stations',
    alternateName: ['World Radio', 'worldradiostations.org'],
    url: 'https://worldradiostations.org/',
    inLanguage: 'en',
  },
];
const topCountries = COUNTRIES.slice(0, 12);
---
<Base
  title="World Radio Stations — Free Live Radio from Around the World"
  description="Listen to thousands of world radio stations live online for free — pop, rock, jazz, news and talk from 200+ countries. Spin the globe or pick a country, right in your browser, no sign-up."
  jsonLd={jsonLd}
>
  <section id="player" class="container hero">
    <RadioPlayer>
      <div slot="intro" class="hero-intro">
        <p class="eyebrow"><span class="live-dot" aria-hidden="true"></span> Live radio from 200+ countries</p>
        <h1>World radio stations,<br /><span class="text-gradient">live on a spinning globe.</span></h1>
        <p class="tagline">
          Listen to thousands of radio stations from around the world — pop, rock, jazz, news, talk and
          sport. Spin the globe, click a country and press play. Free in your browser, no sign-up.
        </p>
        <ul class="trust-row" aria-label="Quick facts">
          <li><strong>1000s</strong> of stations</li>
          <li><strong>$0</strong> free forever</li>
          <li><strong>No</strong> sign-up</li>
        </ul>
      </div>
    </RadioPlayer>
  </section>

  <div class="container">
    <AdSlot type="leaderboard" />
  </div>

  <section id="features" class="container">
    <div class="section-head">
      <h2>Why World Radio Stations</h2>
      <p>Everything you need to listen to radio from anywhere — without the clutter.</p>
    </div>
    <div class="features features-six">
      {features.map((f) => <Feature title={f.title} description={f.description} icon={f.icon} />)}
    </div>
  </section>

  <section class="container about-strip">
    <div class="section-head">
      <h2>Listen to radio stations from around the world</h2>
    </div>
    <div class="prose">
      <p>
        World Radio Stations puts live radio from more than 200 countries in one free player. Every
        station is a light on the globe: tune in to London talk radio, Brazilian samba, Swiss jazz,
        Australian indie or the news from home while you’re abroad. Pick a
        <a href="/country">country</a>, browse by <a href="/moods">mood</a>, or search any station by name
        or genre.
      </p>
      <p>
        These are real broadcasters and internet radio stations streaming live — not playlists. Streams
        play directly from each station’s own servers, so there’s no app to install and no account to
        create. Your favorites and listening history stay in your browser.
      </p>
      <p>
        New to online radio? Start with our picks of the
        <a href="/blog/best-internet-radio-stations">best internet radio stations</a>, the
        <a href="/blog/most-popular-radio-stations-in-the-world">most popular radio stations in the world</a>,
        or learn <a href="/blog/how-to-listen-radio-from-another-country">how to listen to radio from another country</a>.
        Looking for a frequency? See our <a href="/stations">station guides</a> and
        <a href="/blog/uk-radio-stations-frequencies">UK radio frequencies</a>.
      </p>
      <p>
        World Radio Stations is a small independent project, not affiliated with any station or media
        group. The catalog comes from <a href="https://www.radio-browser.info" target="_blank" rel="noopener noreferrer">Radio Browser</a>,
        an open, community-maintained database. <a class="link-arrow" href="/about">More about the project →</a>
      </p>
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <h2>Radio by country</h2>
      <p>Hear how the world sounds — pick a country and start listening.</p>
    </div>
    <div class="facet-grid">
      {topCountries.map((c) => (
        <a class="facet-card" href={`/country/${c.code.toLowerCase()}`}>
          <span class="facet-name">{c.name}</span>
        </a>
      ))}
    </div>
    <div class="section-more">
      <a class="link-arrow" href="/country">All countries →</a>
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <h2>Popular radio stations</h2>
      <p>Frequencies, history and how to listen live to some of the world’s best-known stations.</p>
    </div>
    <div class="facet-grid">
      {featuredStations.map((s) => (
        <a class="facet-card" href={`/stations/${s.slug}`}>
          <span class="facet-name">{s.data.name}</span>
          <span class="facet-count">{s.data.country}</span>
        </a>
      ))}
    </div>
    <div class="section-more">
      <a class="link-arrow" href="/stations">All station guides →</a>
    </div>
  </section>

  <div class="container">
    <AdSlot type="native" />
  </div>

  <section class="container">
    <div class="section-head">
      <h2>From the blog</h2>
      <p>Articles about radio around the world, music and useful tips.</p>
    </div>
    <div class="blog-grid blog-grid-home">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div class="blog-card-body">
            <div class="blog-card-tags">
              {post.data.tags.map((tag) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="section-more">
      <a class="link-arrow" href="/blog">All articles →</a>
    </div>
  </section>

  <section id="faq" class="container">
    <div class="section-head">
      <h2>Frequently asked questions</h2>
      <p>Quick answers to the most common questions about the app.</p>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container">
   <div class="cta-section">
    <h2>Ready to listen?</h2>
    <p>Spin the globe and play any station right in your browser — free and without sign-up.</p>
    <div class="hero-ctas">
      <a class="cta" href="#player">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        Start listening
      </a>
      <span class="cta cta-coming-soon" id="download">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5c0-.6.3-1.1.8-1.4L13.5 12 3.8 21.9c-.5-.3-.8-.8-.8-1.4zm10.6-8.5l2.5-2.5L5.5 3.4c-.3-.2-.6-.3-.9-.3l9 8.9zm6.5-3.7L17.5 9.7l-2.7 2.3 2.7 2.3 2.6-1.4c.8-.5.8-1.7 0-2.1zM4.6 20.9c.3 0 .6-.1.9-.3l10.6-6.1-2.5-2.5-9 8.9z"/></svg>
        Android — coming soon
      </span>
    </div>
   </div>
  </section>
</Base>
